# ---------------------------------------------------------------------------
# Pulse backend configuration
# Copy to .env and fill in. The prototype uses Gemini + local/Supabase Postgres.
# Production swaps these values for Azure OpenAI + Azure Postgres — no code change.
# ---------------------------------------------------------------------------

# Database (local docker-compose default shown). For Supabase, paste the
# connection string from Project Settings → Database.
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse

# Inference provider. "gemini" for the prototype; "azure" later.
LLM_PROVIDER=gemini

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models
EMBED_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-3.5-flash
TAG_MODEL=gemini-3.5-flash

# Demo behaviour: tag each turn synchronously so the dashboard moves live.
# Set false in production (batched tagging on a timer instead).
SYNCHRONOUS_TAGGING=true

# CORS: where the frontend runs.
FRONTEND_ORIGIN=http://localhost:3000

# --- Production (Azure) — unused in the prototype, here for reference ---
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
